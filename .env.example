# Copy to .env — or just run ./start.sh, which creates it and generates the secrets for you.

# Where people reach this installation. Used for links in invitations.
SYNDICATE_PUBLIC_URL=http://localhost:8080

# The port the product listens on.
SYNDICATE_PORT=8080

# Generated by ./start.sh if absent. Both must be kept secret.
# SYNDICATE_DB_PASSWORD=
# SYNDICATE_JWT_SECRET=
