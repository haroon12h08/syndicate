# Copy to .env and adjust. Defaults work for local development as-is.

# --- Database ---
SYNDICATE_DB_NAME=syndicate
SYNDICATE_DB_USER=syndicate
SYNDICATE_DB_PASSWORD=syndicate
SYNDICATE_DB_PORT=5432

# --- Message broker (durable extraction queue) ---
SYNDICATE_RABBITMQ_USER=guest
SYNDICATE_RABBITMQ_PASSWORD=guest
SYNDICATE_RABBITMQ_PORT=5672
SYNDICATE_RABBITMQ_MANAGEMENT_PORT=15672

# --- API ---
SYNDICATE_API_PORT=8080
# Must be at least 32 bytes. CHANGE THIS before exposing the app to anyone.
SYNDICATE_JWT_SECRET=dev-only-secret-change-me-please-this-must-be-at-least-32-bytes-long
SYNDICATE_JWT_EXPIRATION_MS=86400000

# --- Web ---
SYNDICATE_WEB_PORT=5173
# Origins allowed to call the API (comma separated).
SYNDICATE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
